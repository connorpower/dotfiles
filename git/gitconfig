# vim: set ft=gitconfig: set syntax=on:

[include]
    path = ~/.gitconfig-os
[core]
    pager = delta
    editor = nvim
    excludesfile = ~/.gitignore_global
    whitespace = trailing-space,space-before-tab,blank-at-eol
    precomposeunicode = true
[interactive]
    diffFilter = delta --color-only
[diff]
    colorMoved = default
[delta]
    navigate = true
    syntax-theme = catppuccin
    line-numbers = true
[apply]
    whitespace = warn
[merge]
    tool = nvimdiff
    conflictstyle = diff3
[color]
    status = auto
    branch = auto
    ui = auto
[push]
    autoSetupRemote = true
    default = upstream
[pull]
    default = current
    rebase = true
[alias]
    hist = log --date-order --pretty=format:'%C(yellow)%h:%Cblue%d%Creset %s %C(white) (%an), %ar%Creset' --graph
    files-in-commit = diff-tree --no-commit-id --name-only -r
    stats = shortlog -s -n --all
    shash = rev-parse --short HEAD
    lhash = rev-parse HEAD
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[commit]
    gpgsign = true
[tag]
    gpgsign = true
[gpg]
    format = ssh
[init]
    defaultBranch = main

[rerere]
	enabled = true

#-------------------------------------------------------------- identity ---
#
# Who you are depends on where the repo sits. Everything signs with SSH, so
# the signature format never varies and nothing has to switch it.
#
# Neither file below is in this repo, which is public. bootstrap.sh copies
# each from a template in git/ when it is missing, and you fill in the name,
# email, and signing key by hand. Order matters: git takes the last value it
# reads, so the work include overrides the personal one.

[include]
    path = ~/.gitconfig-identity

[includeIf "gitdir:~/scm/work/"]
    path = ~/.gitconfig-work-identity
