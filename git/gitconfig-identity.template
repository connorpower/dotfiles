# vim: set ft=gitconfig: set syntax=on:

# Your personal identity and signing key. bootstrap.sh copied this file from
# git/gitconfig-identity.template because ~/.gitconfig-identity did not exist.
#
# Replace all three values below.
#
#   name        as you want it on a commit
#   email       an address on your GitHub account, or GitHub shows the
#               commits as unverified and does not link them to your profile
#   signingkey  the path to a public key, such as ~/.ssh/<name>.pub
#
# Add the same key to GitHub under "SSH and GPG keys" with the type
# "Signing key". A key added for authentication alone does not verify
# signatures.
#
# The dotfiles repo is public, so nothing tracks this file. Each machine
# needs its own copy.
[user]
    name = FIXME
    email = FIXME
    signingkey = FIXME
